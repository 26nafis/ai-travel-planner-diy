# Kosongkan VITE_API_URL untuk memakai mode demo (data & akun tersimpan di browser).
# Isi dengan URL backend Express bila backend sudah siap, mis. http://localhost:3000
VITE_API_URL=

# Kunci Google Maps JavaScript API untuk browser (batasi berdasarkan domain di Google Cloud Console).
# Bila kosong, aplikasi menampilkan peta skematis bawaan.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
