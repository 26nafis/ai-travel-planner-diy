# Kosongkan VITE_API_URL untuk mempertahankan itinerary lokal di browser.
# Isi hanya bila semua endpoint memakai API backend penuh.
VITE_API_URL=

# Chat dapat diarahkan ke Worker satu-origin. Kosong di development = chatbot demo;
# pada build production mode lokal akan otomatis memakai /api/chat.
VITE_CHAT_API_URL=

# Basemap OpenFreeMap tidak memerlukan API key.
# Opsional: ganti host OSRM (nilai kosong memakai server demo untuk pengembangan).
VITE_OSRM_BASE_URL=https://router.project-osrm.org
